		{
			"name": "[concat(parameters('factoryName'), '/Silver_data_transform')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "preparing gold layered data through data flow ",
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"linkedService": {
								"referenceName": "ls_datalake_01",
								"type": "LinkedServiceReference"
							},
							"name": "dimairline"
						},
						{
							"linkedService": {
								"referenceName": "ls_datalake_01",
								"type": "LinkedServiceReference"
							},
							"name": "dimflight"
						},
						{
							"linkedService": {
								"referenceName": "ls_datalake_01",
								"type": "LinkedServiceReference"
							},
							"name": "dimpassenger"
						},
						{
							"linkedService": {
								"referenceName": "ls_datalake_01",
								"type": "LinkedServiceReference"
							},
							"name": "dimairport"
						},
						{
							"linkedService": {
								"referenceName": "ls_datalake_01",
								"type": "LinkedServiceReference"
							},
							"name": "dimfactbooking"
						}
					],
					"sinks": [
						{
							"linkedService": {
								"referenceName": "ls_datalake_01",
								"type": "LinkedServiceReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "joinairline"
						},
						{
							"name": "selectcols"
						},
						{
							"name": "aggregateairline"
						},
						{
							"name": "ranking"
						},
						{
							"name": "filter1top5"
						},
						{
							"name": "alterRow1"
						}
					],
					"scriptLines": [
						"source(output(",
						"          airline_id as short,",
						"          airline_name as string,",
						"          country as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     format: 'delta',",
						"     fileSystem: 'silver-layer-data',",
						"     folderPath: 'DimAirline') ~> dimairline",
						"source(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     format: 'delta',",
						"     fileSystem: 'silver-layer-data',",
						"     folderPath: 'dimflight') ~> dimflight",
						"source(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     format: 'delta',",
						"     fileSystem: 'silver-layer-data',",
						"     folderPath: 'dimpassenger') ~> dimpassenger",
						"source(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     format: 'delta',",
						"     fileSystem: 'silver-layer-data',",
						"     folderPath: 'dimairport') ~> dimairport",
						"source(output(",
						"          booking_id as integer,",
						"          passenger_id as integer,",
						"          flight_id as integer,",
						"          airline_id as integer,",
						"          origin_airport_id as integer,",
						"          destination_airport_id as integer,",
						"          booking_date as date,",
						"          ticket_cost as integer,",
						"          flight_duration_mins as integer,",
						"          checkin_status as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     format: 'delta',",
						"     fileSystem: 'silver-layer-data',",
						"     folderPath: 'factbooking') ~> dimfactbooking",
						"dimfactbooking, dimairline join(dimfactbooking@airline_id == dimairline@airline_id,",
						"     joinType:'left',",
						"     matchType:'exact',",
						"     ignoreSpaces: false,",
						"     broadcast: 'auto')~> joinairline",
						"joinairline select(mapColumn(",
						"          booking_id,",
						"          passenger_id,",
						"          flight_id,",
						"          airline_id = dimfactbooking@airline_id,",
						"          origin_airport_id,",
						"          destination_airport_id,",
						"          booking_date,",
						"          ticket_cost,",
						"          flight_duration_mins,",
						"          checkin_status,",
						"          airline_name,",
						"          country",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> selectcols",
						"selectcols aggregate(groupBy(airline_name),",
						"     totalsales = sum(ticket_cost)) ~> aggregateairline",
						"aggregateairline window(desc(totalsales, true),",
						"     top_airline = denseRank()) ~> ranking",
						"ranking filter(top_airline<6) ~> filter1top5",
						"filter1top5 alterRow(upsertIf(1==1)) ~> alterRow1",
						"alterRow1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     format: 'delta',",
						"     fileSystem: 'gold-layer-data',",
						"     folderPath: 'aq',",
						"     mergeSchema: false,",
						"     autoCompact: false,",
						"     optimizedWrite: false,",
						"     vacuum: 0,",
						"     deletable: false,",
						"     insertable: true,",
						"     updateable: false,",
						"     upsertable: true,",
						"     keys:['airline_name'],",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> sink1"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ls_datalake_01')]"
			]
		},
