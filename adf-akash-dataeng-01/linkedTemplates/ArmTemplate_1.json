		{
			"name": "[concat(parameters('factoryName'), '/DS_OnPrem_File_Source')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "Parameterized dataset for reading files from on-premises File System",
				"linkedServiceName": {
					"referenceName": "ls_filesystem_onprem_01",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"p_file_name": {
